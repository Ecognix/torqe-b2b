# Supabase project configuration. The publishable/anon key may be exposed to the
# browser; the service-role key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for Supabase Auth invitation redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NVIDIA model credentials stay server-side and are never returned by console APIs.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Server-only base64-encoded 32-byte key for encrypting workspace AI API keys.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONSOLE_ENCRYPTION_KEY=
