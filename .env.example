# Console invitation access. Generate a unique, high-entropy invite code and
# a separate 32+ character session secret for each deployment.
CONSOLE_INVITE_CODE=
CONSOLE_SESSION_SECRET=

# Supabase project configuration (the anon/publishable key is safe for browser use;
# never expose a service-role key through NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NVIDIA model credentials stay server-side and are never returned by console APIs.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=
